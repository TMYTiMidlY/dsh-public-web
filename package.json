{
  "name": "dsh-public-web",
  "version": "0.1.3",
  "private": true,
  "description": "Extend the installed official DeepSeek Harness Web clients with remote settings and file preview compatibility.",
  "type": "module",
  "scripts": {
    "test": "node --test --test-isolation=none tests/*.test.js"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
